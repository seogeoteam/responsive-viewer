# ========================================================
# Responsive Viewer — Environment Configuration Template
# ========================================================
# For Chrome Developer Mode:
# Copy this file to '.env.local' and supply your personal keys.
# DO NOT commit real API keys to version control.
# ========================================================

# Google Gemini API Key (for automated responsive AI layout audits)
REACT_APP_GEMINI_API_KEY=

# Google Cloud Platform API Key (optional)
REACT_APP_GCP_API_KEY=

# Platform environment override ('CHROME' or 'LOCAL')
REACT_APP_PLATFORM=CHROME
